# Copy this file to ".env" (cp .env.example .env) and adjust only what you need.

# Where the browser sends API calls.
#   /gateway               -> (default) uses the Vite dev proxy, no CORS setup needed
#   http://localhost:8080  -> call the gateway directly (requires CORS on the gateway)
VITE_API_BASE_URL=/gateway

# Where the Vite dev proxy forwards /gateway/* to (your API Gateway).
GATEWAY_URL=http://localhost:8080

# Gateway paths. Only the auth path is confirmed. The other three follow the same
# "/<service-id>/..." pattern but are UNVERIFIED - use the "API check" page in the app
# to confirm them, or override them here.
# VITE_AUTH_PATH=/auth-service/auth
# VITE_BOOKS_PATH=/book-service/books
# VITE_RENTALS_PATH=/rental-service/rentals
# VITE_FINES_PATH=/fine-service/fines

# Roles (comma separated) that see Add/Edit/Delete book buttons.
# If your JWT carries no role at all, those buttons are shown and the backend decides.
VITE_MANAGE_ROLES=ADMIN,LIBRARIAN

# Optional: show a role dropdown on the signup form (e.g. STUDENT,LIBRARIAN). Leave empty to hide it.
VITE_SIGNUP_ROLES=

# Optional: currency symbol shown before fine amounts (e.g. $ or Rs.). Empty = plain number.
VITE_CURRENCY_SYMBOL=
